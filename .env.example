# ---------------------------------------------------------------------------
# TemporalGuard – Docker Compose / local development environment
# Copy to .env and adjust as needed. Never commit real secrets.
# Self-hosted SigNoz only — no SigNoz Cloud credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development

# API
API_PORT=3000
API_HOST_PORT=3000

# PostgreSQL (TemporalGuard application database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=temporalguard
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# OpenTelemetry → local collector (no cloud ingestion keys)
OTEL_SERVICE_NAME=temporalguard-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Self-hosted SigNoz
SIGNOZ_VERSION=v0.128.0
OTELCOL_TAG=v0.144.5
SIGNOZ_UI_PORT=3301
SIGNOZ_JWT_SECRET=temporalguard-local-dev-secret
