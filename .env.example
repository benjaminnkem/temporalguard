# ---------------------------------------------------------------------------
# TemporalGuard – Docker Compose / local development environment
# Copy to .env and adjust as needed. Never commit real secrets.
# Supports self-hosted SigNoz or SigNoz Cloud.
# ---------------------------------------------------------------------------

NODE_ENV=development
SIGNOZ_MODE=self_hosted

# API
API_PORT=3000
API_HOST_PORT=4000
WEB_PORT=3000

# PostgreSQL (TemporalGuard application database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=temporalguard
POSTGRES_PORT=5432
DB_SCHEMA=public

# Redis
REDIS_PORT=6379
QUEUE_PREFIX=temporalguard
JOB_RETRY_ATTEMPTS=5
JOB_STALLED_INTERVAL_MS=30000
INVESTIGATION_QUEUE_CONCURRENCY=4
INVESTIGATION_MAX_CONCURRENT_PER_COMPANY=3
WORKER_HEALTH_PORT=3002

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# OpenTelemetry → local collector (no cloud ingestion keys)
OTEL_SERVICE_NAME=temporalguard-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_LOGS_EXPORTER=otlp
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Self-hosted SigNoz
SIGNOZ_VERSION=v0.128.0
OTELCOL_TAG=v0.144.5
SIGNOZ_UI_PORT=3301
SIGNOZ_JWT_SECRET=temporalguard-local-dev-secret

# Application mode. Product pages remain mock-backed in every mode.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_SIGNOZ_UI_URL=http://localhost:3301

# SigNoz query API (backend only). SIGNOZ_API_KEY must be a service-account
# API key with the signoz-viewer role; the ingestion key below cannot read
# telemetry.
SIGNOZ_UI_URL=http://localhost:3301
SIGNOZ_API_URL=http://signoz:8080
SIGNOZ_API_KEY=
SIGNOZ_QUERY_TIMEOUT_MS=10000
SIGNOZ_QUERY_MAX_RANGE_HOURS=24
SIGNOZ_COMPARISON_MAX_RANGE_DAYS=30
SIGNOZ_QUERY_MAX_RETRIES=2
SIGNOZ_QUERY_CIRCUIT_BREAKER_THRESHOLD=5
SIGNOZ_QUERY_CIRCUIT_BREAKER_RESET_MS=30000
SIGNOZ_QUERY_RATE_LIMIT_PER_MINUTE=120

INVESTIGATION_AGENT_ENABLED=false
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-terra
AI_MAX_STEPS=8
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=60000

# Authentication (replace every value outside local development)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:3000

# Cloudinary (backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=temporalguard/workspaces

# Upgrade features are opt-in until their APIs, workers, and migrations land.
FEATURE_INVESTIGATIONS=false
FEATURE_COMPARISONS=false
FEATURE_RULE_SIMULATION=false
FEATURE_DEPLOYMENT_ANALYSIS=false
FEATURE_TELEMETRY_QUALITY=false
FEATURE_SIGNOZ_ASSET_PROVISIONING=false
FEATURE_DEMO_SYSTEM=false

# SigNoz Cloud collector mode (backend/collector only)
SIGNOZ_INGESTION_ENDPOINT=https://ingest.<region>.signoz.cloud:443
SIGNOZ_INGESTION_KEY=
