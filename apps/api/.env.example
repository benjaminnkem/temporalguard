# Local development (API on host, infrastructure via Docker Compose)
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=temporalguard
DB_SCHEMA=public

REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_PREFIX=temporalguard
JOB_RETRY_ATTEMPTS=5
JOB_STALLED_INTERVAL_MS=30000
INVESTIGATION_QUEUE_CONCURRENCY=4
INVESTIGATION_MAX_CONCURRENT_PER_COMPANY=3
WORKER_HEALTH_PORT=3002

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

NODE_ENV=development
SIGNOZ_MODE=self_hosted

# OpenTelemetry → local self-hosted collector (no SigNoz Cloud keys)
OTEL_SERVICE_NAME=temporalguard-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=temporalguard/workspaces

# SigNoz query access is server-only. The key may be left empty until query
# features are enabled.
SIGNOZ_API_URL=http://localhost:3301
SIGNOZ_UI_URL=http://localhost:3301
SIGNOZ_API_KEY=
SIGNOZ_QUERY_TIMEOUT_MS=10000
SIGNOZ_QUERY_MAX_RANGE_HOURS=24
SIGNOZ_COMPARISON_MAX_RANGE_DAYS=30
SIGNOZ_QUERY_MAX_RETRIES=2
SIGNOZ_QUERY_CIRCUIT_BREAKER_THRESHOLD=5
SIGNOZ_QUERY_CIRCUIT_BREAKER_RESET_MS=30000
SIGNOZ_QUERY_RATE_LIMIT_PER_MINUTE=120

INVESTIGATION_AGENT_ENABLED=false
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-terra
AI_MAX_STEPS=8
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=60000

# Upgrade features remain opt-in while their storage and worker paths land.
FEATURE_INVESTIGATIONS=false
FEATURE_COMPARISONS=false
FEATURE_RULE_SIMULATION=false
FEATURE_DEPLOYMENT_ANALYSIS=false
FEATURE_TELEMETRY_QUALITY=false
FEATURE_SIGNOZ_ASSET_PROVISIONING=false
FEATURE_DEMO_SYSTEM=false
