{
  "name": "temporalguard-node",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the TemporalGuard public events API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "temporalguard",
    "events",
    "observability",
    "sdk",
    "ingest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkembenjamin/temporalguard.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/nkembenjamin/temporalguard/issues"
  },
  "homepage": "https://www.npmjs.com/package/temporalguard-node",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsx": "^4.20.3",
    "typescript": "5.9.2"
  }
}
