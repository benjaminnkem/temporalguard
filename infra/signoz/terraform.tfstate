            "version": "v5",
            "widgets": "[{\"bucketCount\":30,\"bucketWidth\":0,\"columnUnits\":{},\"description\":\"Workflow reliability and duration by deployed service version.\",\"fillSpans\":false,\"id\":\"deployment_impact-0\",\"isStacked\":false,\"mergeAllActiveQueries\":false,\"nullZeroValues\":\"zero\",\"opacity\":\"1\",\"panelTypes\":\"value\",\"query\":{\"builder\":{\"queryData\":[],\"queryFormulas\":[]},\"clickhouse_sql\":[{\"disabled\":false,\"legend\":\"Workflow completions\",\"name\":\"A\",\"query\":\"SELECT now() AS ts, toFloat64(count()) AS value FROM signoz_traces.distributed_signoz_index_v3 WHERE timestamp \\u003e= fromUnixTimestamp64Nano($start_timestamp_nano) AND timestamp \\u003c= fromUnixTimestamp64Nano($end_timestamp_nano) AND serviceName = 'temporalguard-demo' AND name = 'temporalguard.workflow.complete'\"}],\"id\":\"deployment_impact-0-query\",\"promql\":[{\"disabled\":true,\"legend\":\"\",\"name\":\"A\",\"query\":\"\"}],\"queryType\":\"clickhouse_sql\"},\"selectedLogFields\":[],\"selectedTracesFields\":[],\"softMax\":0,\"softMin\":0,\"stackedBarChart\":false,\"thresholds\":[],\"timePreferance\":\"GLOBAL_TIME\",\"title\":\"Workflow completions\",\"yAxisUnit\":\"none\"},{\"bucketCount\":30,\"bucketWidth\":0,\"columnUnits\":{},\"description\":\"Workflow reliability and duration by deployed service version.\",\"fillSpans\":false,\"id\":\"deployment_impact-1\",\"isStacked\":false,\"mergeAllActiveQueries\":false,\"nullZeroValues\":\"zero\",\"opacity\":\"1\",\"panelTypes\":\"value\",\"query\":{\"builder\":{\"queryData\":[],\"queryFormulas\":[]},\"clickhouse_sql\":[{\"disabled\":false,\"legend\":\"Deadline misses\",\"name\":\"A\",\"query\":\"SELECT now() AS ts, toFloat64(count()) AS value FROM signoz_traces.distributed_signoz_index_v3 WHERE timestamp \\u003e= fromUnixTimestamp64Nano($start_timestamp_nano) AND timestamp \\u003c= fromUnixTimestamp64Nano($end_timestamp_nano) AND serviceName = 'temporalguard-demo' AND name = 'temporalguard.workflow.overdue'\"}],\"id\":\"deployment_impact-1-query\",\"promql\":[{\"disabled\":true,\"legend\":\"\",\"name\":\"A\",\"query\":\"\"}],\"queryType\":\"clickhouse_sql\"},\"selectedLogFields\":[],\"selectedTracesFields\":[],\"softMax\":0,\"softMin\":0,\"stackedBarChart\":false,\"thresholds\":[],\"timePreferance\":\"GLOBAL_TIME\",\"title\":\"Deadline misses\",\"yAxisUnit\":\"none\"},{\"bucketCount\":30,\"bucketWidth\":0,\"columnUnits\":{},\"description\":\"Workflow reliability and duration by deployed service version.\",\"fillSpans\":false,\"id\":\"deployment_impact-2\",\"isStacked\":false,\"mergeAllActiveQueries\":false,\"nullZeroValues\":\"zero\",\"opacity\":\"1\",\"panelTypes\":\"value\",\"query\":{\"builder\":{\"queryData\":[],\"queryFormulas\":[]},\"clickhouse_sql\":[{\"disabled\":false,\"legend\":\"Average completion time\",\"name\":\"A\",\"query\":\"SELECT now() AS ts, toFloat64(avg(duration_nano) / 1000000) AS value FROM signoz_traces.distributed_signoz_index_v3 WHERE timestamp \\u003e= fromUnixTimestamp64Nano($start_timestamp_nano) AND timestamp \\u003c= fromUnixTimestamp64Nano($end_timestamp_nano) AND serviceName = 'temporalguard-demo' AND name = 'temporalguard.workflow.complete'\"}],\"id\":\"deployment_impact-2-query\",\"promql\":[{\"disabled\":true,\"legend\":\"\",\"name\":\"A\",\"query\":\"\"}],\"queryType\":\"clickhouse_sql\"},\"selectedLogFields\":[],\"selectedTracesFields\":[],\"softMax\":0,\"softMin\":0,\"stackedBarChart\":false,\"thresholds\":[],\"timePreferance\":\"GLOBAL_TIME\",\"title\":\"Average completion time\",\"yAxisUnit\":\"ms\"},{\"bucketCount\":30,\"bucketWidth\":0,\"columnUnits\":{},\"description\":\"Workflow reliability and duration by deployed service version.\",\"fillSpans\":false,\"id\":\"deployment_impact-3\",\"isStacked\":false,\"mergeAllActiveQueries\":false,\"nullZeroValues\":\"zero\",\"opacity\":\"1\",\"panelTypes\":\"graph\",\"query\":{\"builder\":{\"queryData\":[],\"queryFormulas\":[]},\"clickhouse_sql\":[{\"disabled\":false,\"legend\":\"Workflow outcomes over time\",\"name\":\"A\",\"query\":\"SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) AS ts, replaceOne(name, 'temporalguard.workflow.', '') AS outcome, toFloat64(count()) AS value FROM signoz_traces.distributed_signoz_index_v3 WHERE timestamp \\u003e= fromUnixTimestamp64Nano($start_timestamp_nano) AND timestamp \\u003c= fromUnixTimestamp64Nano($end_timestamp_nano) AND serviceName = 'temporalguard-demo' AND name IN ('temporalguard.workflow.complete', 'temporalguard.workflow.overdue') GROUP BY ts, outcome ORDER BY ts ASC\"}],\"id\":\"deployment_impact-3-query\",\"promql\":[{\"disabled\":true,\"legend\":\"\",\"name\":\"A\",\"query\":\"\"}],\"queryType\":\"clickhouse_sql\"},\"selectedLogFields\":[],\"selectedTracesFields\":[],\"softMax\":0,\"softMin\":0,\"stackedBarChart\":false,\"thresholds\":[],\"timePreferance\":\"GLOBAL_TIME\",\"title\":\"Workflow outcomes over time\",\"yAxisUnit\":\"none\"},{\"bucketCount\":30,\"bucketWidth\":0,\"columnUnits\":{},\"description\":\"Workflow reliability and duration by deployed service version.\",\"fillSpans\":false,\"id\":\"deployment_impact-4\",\"isStacked\":false,\"mergeAllActiveQueries\":false,\"nullZeroValues\":\"zero\",\"opacity\":\"1\",\"panelTypes\":\"bar\",\"query\":{\"builder\":{\"queryData\":[],\"queryFormulas\":[]},\"clickhouse_sql\":[{\"disabled\":false,\"legend\":\"Workflow span duration\",\"name\":\"A\",\"query\":\"SELECT now() AS ts, replaceOne(name, 'temporalguard.workflow.', '') AS operation, toFloat64(avg(duration_nano) / 1000000) AS value FROM signoz_traces.distributed_signoz_index_v3 WHERE timestamp \\u003e= fromUnixTimestamp64Nano($start_timestamp_nano) AND timestamp \\u003c= fromUnixTimestamp64Nano($end_timestamp_nano) AND serviceName = 'temporalguard-demo' AND name IN ('temporalguard.workflow.create', 'temporalguard.workflow.complete', 'temporalguard.workflow.overdue') GROUP BY operation ORDER BY value DESC\"}],\"id\":\"deployment_impact-4-query\",\"promql\":[{\"disabled\":true,\"legend\":\"\",\"na