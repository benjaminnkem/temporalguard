{
  "name": "temporalguard",
  "private": true,
  "scripts": {
    "signoz:fmt": "bash scripts/signoz-terraform.sh fmt",
    "signoz:validate": "bash scripts/signoz-terraform.sh validate",
    "signoz:plan": "bash scripts/signoz-terraform.sh plan",
    "signoz:apply": "bash scripts/signoz-terraform.sh apply",
    "verify:signoz": "node scripts/verify-signoz-otel.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:worker": "pnpm --filter worker dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
