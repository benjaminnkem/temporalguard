# Reference only. render.yaml supplies fixed values and Render service
# references automatically. Never commit actual secret values.
NODE_ENV=production
DATABASE_URL=<Render reference>
REDIS_URL=<Render reference>
FRONTEND_ORIGIN=https://temporalguard.oluwadunsin.dev
JWT_ACCESS_SECRET=<Render generated>
JWT_REFRESH_SECRET=<Render generated>
ENCRYPTION_KEY=<Render generated>
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
RUN_PROCESSING_WORKER_IN_API=true
SIGNOZ_MODE=cloud
# Copy the regional OTLP endpoint and ingestion key from SigNoz:
# Settings > Ingestion Settings.
SIGNOZ_INGESTION_ENDPOINT=https://ingest.<region>.signoz.cloud:443
SIGNOZ_INGESTION_KEY=<SigNoz ingestion key>
# Use your SigNoz Cloud workspace URL for all three URL values.
SIGNOZ_API_URL=https://<workspace>.signoz.cloud
SIGNOZ_UI_URL=https://<workspace>.signoz.cloud
NEXT_PUBLIC_SIGNOZ_UI_URL=https://<workspace>.signoz.cloud
# Create a service account with the signoz-viewer role. This is not the
# ingestion key.
SIGNOZ_API_KEY=<SigNoz service-account API key>
CLOUDINARY_CLOUD_NAME=<Optional>
CLOUDINARY_API_KEY=<Optional>
CLOUDINARY_API_SECRET=<Optional>
FEATURE_INVESTIGATIONS=true
FEATURE_COMPARISONS=true
FEATURE_RULE_SIMULATION=true
FEATURE_DEPLOYMENT_ANALYSIS=true
FEATURE_TELEMETRY_QUALITY=true
FEATURE_SIGNOZ_ASSET_PROVISIONING=false
FEATURE_DEMO_SYSTEM=false
