# Values marked "Render reference" are wired by render.yaml.
NODE_ENV=production
DATABASE_URL=<Render reference>
REDIS_URL=<Render reference>
FRONTEND_ORIGIN=https://app.example.com
JWT_ACCESS_SECRET=<Render generated>
JWT_REFRESH_SECRET=<Render generated>
ENCRYPTION_KEY=<Render generated>
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
OTEL_EXPORTER_OTLP_ENDPOINT=<Render private ingester host:port>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
SIGNOZ_MODE=self_hosted
SIGNOZ_API_URL=<Render private SigNoz host:port>
SIGNOZ_UI_URL=https://your-signoz-service.onrender.com
SIGNOZ_PUBLIC_URL=https://your-signoz-service.onrender.com
FEATURE_INVESTIGATIONS=true
FEATURE_COMPARISONS=true
FEATURE_RULE_SIMULATION=true
FEATURE_DEPLOYMENT_ANALYSIS=true
FEATURE_TELEMETRY_QUALITY=true
